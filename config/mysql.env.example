# Credenciales del contenedor MySQL.
# Copia este fichero a config/mysql.env y sustituye los valores.
# config/mysql.env esta excluido de git: nunca lo commitees.
#
# En docker-compose.yml, run-server.sh deriva las credenciales NWNX_SQL de estas
# variables. docker-compose-dev.yml no usa ese runner, por lo que sus valores
# deben coincidir con NWNX_SQL_USERNAME / PASSWORD / DATABASE en nwserver-dev.env.
#
# Docker solo consume estas variables al crear un volumen vacio. Cambiarlas
# despues NO altera los usuarios de un volumen ya inicializado.

MYSQL_ROOT_PASSWORD=cambia_esto_por_una_cadena_larga_aleatoria
MYSQL_DATABASE=pdb_dev
MYSQL_USER=pdb_dev
MYSQL_PASSWORD=cambia_esto_por_otra_cadena_larga_distinta

# Secret used to encrypt control-panel TOTP seeds. Generate a Fernet key and
# keep the same value across restarts. Losing or changing it makes existing MFA
# enrollments unreadable.
CNR_EDITOR_MFA_ENCRYPTION_KEY=replace_with_a_urlsafe_base64_fernet_key
