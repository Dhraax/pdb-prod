# NWN - Configuración básica del servidor
NWN_SERVERNAME=ES) PROD - PDB - DEV
NWN_PORT=5121
NWN_MODULE=PB_EE_PROD
NWN_MAXCLIENTS=120
NWN_PUBLICSERVER=1
NWN_MINLEVEL=1
NWN_MAXLEVEL=40
NWN_PAUSEANDPLAY=0
NWN_PVP=2
NWN_SERVERVAULT=1
NWN_ELC=0
NWN_ILR=1
NWN_GAMETYPE=3
NWN_ONEPARTY=0
NWN_DIFFICULTY=3
NWN_AUTOSAVEINTERVAL=0
NWN_RELOADWHENEMPTY=0
NWN_PLAYERPASSWORD=
NWN_DMPASSWORD=test
NWN_ADMINPASSWORD=test
NWN_TAIL_LOGS=y

# NWN - Configuración de NWSync
#NWN_NWSYNCURL=http://65.108.209.173/nwsync/

# NWNXEE - Configuración global
NWNX_CORE_ALLOW_NWNX_FUNCTIONS_IN_EXECUTE_SCRIPT_CHUNK=1
NWNX_CORE_LOG_LEVEL=6

# NWNXEE - Plugins - Activa los plugins que necesites aquí
