NWNX_EFFECT_SKIP=n
NWNX_ELC_SKIP=y
NWNX_ENCOUNTER_SKIP=n
NWNX_EVENTS_SKIP=n
NWNX_FEAT_SKIP=n
NWNX_FEEDBACK_SKIP=n
NWNX_HTTPCLIENT_SKIP=y
NWNX_ITEMPROPERTY_SKIP=n
NWNX_ITEM_SKIP=n
NWNX_JVM_SKIP=y
NWNX_LUA_SKIP=y
NWNX_MAXLEVEL_SKIP=y
NWNX_METRICS_INFLUXDB_SKIP=y
NWNX_MONO_SKIP=y
NWNX_NOSTACK_SKIP=y
NWNX_OBJECT_SKIP=n
