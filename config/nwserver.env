# NWNXEE - Plugins - Configuración adicional de plugins
NWNX_RENAME_ALLOW_DM=TRUE
NWNX_SERVERLOGREDIRECTOR_LOG_LEVEL=5
NWNX_TWEAKS_ALWAYS_RETURN_FULL_DEX_STAT=true
NWNX_TWEAKS_CAST_ALL_ON_HIT_CAST_SPELL_ITEM_PROPERTIES=true
NWNX_TWEAKS_FIX_UNLIMITED_POTIONS_BUG=true
NWNX_TWEAKS_UNHARDCODE_SPECIAL_ABILITY_TARGET_TYPE=y
NWNX_TWEAKS_HIDE_CLASSES_ON_CHAR_LIST=TRUE
NWNX_TWEAKS_HIDE_PLAYERS_ON_CHAR_LIST=1

# NWNXEE - Configuración de InfluxDB - Métricas
NWNX_METRICS_INFLUXDB_HOST=influxdb
NWNX_METRICS_INFLUXDB_PORT=8089
