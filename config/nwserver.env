NWNX_SKILLRANKS_SKIP=n
NWNX_SPELLCHECKER_SKIP=y
NWNX_SQL_SKIP=n
NWNX_SQL_TYPE=MYSQL
NWNX_SQL_HOST=mysql
NWNX_SQL_PORT=3306
NWNX_SQL_CHARACTER_SET=utf8mb4
