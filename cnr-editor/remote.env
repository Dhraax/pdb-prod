# Non-secret deployment controls installed by rsync.sh on the development host.
CONTROL_PANEL_TITLE=Control Panel
CONTROL_PANEL_SUBTITLE=System management
CNR_EDITOR_PORT=8088
CNR_EDITOR_WRITES_ENABLED=false
CNR_EDITOR_MYSQL_ENV_FILE=../dev-server/config/mysql.env
CNR_EDITOR_NETWORK_NAME=dev-server_default
