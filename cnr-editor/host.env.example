# Control panel on the production host.
#
# Copy to cnr-editor/.env inside the host's server directory, the one holding
# docker-compose.yml, config/ and web-restart.sh, then run ./web-restart.sh.
# Only non-secret controls live here: the database credentials and
# CNR_EDITOR_MFA_ENCRYPTION_KEY stay in config/mysql.env.
CONTROL_PANEL_TITLE=Control Panel
CONTROL_PANEL_SUBTITLE=System management

# Loopback only. The panel is never published on the public interface: reach
# it through an SSH tunnel,
#   ssh -L 8088:127.0.0.1:8088 <user>@<host>
# and open http://localhost:8088. For a public HTTPS name instead, keep this
# binding, point the reverse proxy at 127.0.0.1:8088, and change the origin
# below to that https:// URL with CNR_EDITOR_COOKIE_SECURE=true.
CNR_EDITOR_PORT=127.0.0.1:8088
CNR_EDITOR_FRONTEND_ORIGIN=http://localhost:8088
CNR_EDITOR_COOKIE_SECURE=false

# Relative to cnr-editor/: the game stack's own MySQL credentials.
CNR_EDITOR_MYSQL_ENV_FILE=../config/mysql.env
# docker-compose.yml fixes the project name as "server".
CNR_EDITOR_NETWORK_NAME=server_default

CNR_EDITOR_WRITES_ENABLED=false
CNR_EDITOR_SESSION_TTL_HOURS=12
CNR_EDITOR_MFA_ISSUER=Control Panel
CNR_EDITOR_MFA_CHALLENGE_TTL_MINUTES=5
CNR_EDITOR_LOGIN_FAILURE_WINDOW_MINUTES=15
