        "Text": {
          "type": "cexolocstring",
          "value": {
            "8": "Saludos aventurero, hacia tiempo que no venía nadie a la ciudad, *en voz baja* a parte de ese bruto bárbaro de norte. Te invito a un trago y así te explicaré una historia si lo deseas."
          }
        }
      },
      {
        "__struct_id": 1,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
          "value": 1
