          "type": "list",
          "value": [
            {
              "__struct_id": 0,
              "Active": {
                "type": "resref",
                "value": ""
              },
              "Index": {
                "type": "dword",
                "value": 4
              },
              "IsChild": {
                "type": "byte",
                "value": 0
              }
            }
          ]
        },
        "Script": {
          "type": "resref",
          "value": ""
        },
        "Sound": {
          "type": "resref",
          "value": ""
        },
        "Speaker": {
          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "8": "Por lo visto, están recelosos unos de otros y los enfrentamientos están servidos. Se cuenta que estas reliquias guardan un secreto ancestral y que están relacionadas unas con las otras. Una sola no tiene poder, pero juntándolas todas... ¡¡quién sabe!! ¡¡Jajajajaja!! Pero bueno, no pongas esa cara que  solo es una historia..."
          }
        }
      },
      {
        "__struct_id": 4,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
