        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "8": "¿Qué haces aun aquí? No te he dicho que vayas a hablar con esa giganta apestosa."
          }
        }
      },
      {
        "__struct_id": 2,
        "Animation": {
