        "Text": {
          "type": "cexolocstring",
          "value": {
            "8": "En Emnekhul tenemos a la reina vampira más bella y hermosa que jamás hayan visto vuestros ojos. "
          }
        }
      },
      {
        "__struct_id": 1,
        "Animation": {
