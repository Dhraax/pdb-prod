        "Text": {
          "type": "cexolocstring",
          "value": {
            "8": "¡Ey amigo! ¡Pareces nuevo por aquí! Soy Wilfred el Rojo. ¡Afamado cazador de dragones!, ¿quieres escuchar mi historia?"
          }
        }
      },
      {
        "__struct_id": 1,
        "Animation": {
