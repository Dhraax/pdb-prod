        "Text": {
          "type": "cexolocstring",
          "value": {
            "8": "Bienvenido seas al altar de la Dama de la Cosecha, inclinaos y rezad con fervor a la dadora de vida. ¿Puedo hacer algo por vos?"
          }
        }
      },
