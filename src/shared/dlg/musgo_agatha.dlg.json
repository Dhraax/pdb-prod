        "Text": {
          "type": "cexolocstring",
          "value": {
            "8": "Bienvenido al Dragón de Diamante, soy Agatha, quizás hayas hoído hablar de mi. Soy una famosa perfumista. ¿Quieres ver mis perfumes?"
          }
        }
      },
