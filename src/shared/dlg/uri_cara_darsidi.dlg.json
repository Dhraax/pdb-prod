          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "8": "Entonces nos veremos allí. Iré adelantándome para tenderle una trampa a la criatura, no tardes. <StartAction>*Ves como Darsidian se toma una pócima de invisibilidad y se marcha hacia el lugar*</Start>"
          }
        }
      },
      {
        "__struct_id": 5,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
          "value": 1
        },
        "Comment": {
          "type": "cexostring",
