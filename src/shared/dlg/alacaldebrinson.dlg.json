        },
        "Sound": {
          "type": "resref",
          "value": ""
        },
        "Speaker": {
          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "8": "Claro, por eso no te preocupes... Tendrás la recompensa y te compraré todas las cabelleras que me traigas."
          }
        }
      },
