        "Text": {
          "type": "cexolocstring",
          "value": {
            "8": "Estas son las minas de Kazad. Soy el capataz de las minas. Hace unos días que la situación es insostenible... ¡No sé qué hacer! Brbrbr"
          }
        }
      },
      {
        "__struct_id": 1,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
