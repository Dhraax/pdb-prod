        "Text": {
          "type": "cexolocstring",
          "value": {
            "8": "Existen ciertos códigos para cambiar el color y formato del texto que puedes emplear al escribir. Puedes colorear el texto con varios colores, o añadir párrafos nuevos. Para llevar a cabo esto, escoge y habla el código deseado:\n- <StartCheck>Nuevo párrafo</Start>\n- <StartCheck>Color</Start> + <StartCheck>Rojo</Start> / <StartCheck>Azul</Start> / <StartCheck>Amarillo</Start> / <StartCheck>Verde</Start> / <StartCheck>Violeta</Start> / <StartCheck>Naranja</Start> / <StartCheck>Cian</Start> / <StartCheck>Blanco</Start>"
          }
        }
