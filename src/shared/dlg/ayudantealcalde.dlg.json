        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "¡Bienvenidos a la Alcaldía de Purskul! Mi nombre es Rodolfo, y estoy aquí para asistirles en lo que necesiten. ¿En qué puedo ayudarles hoy?"
          }
        }
      },
      {
        "__struct_id": 1,
        "ActionParams": {
          "type": "list",
          "value": []
        },
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
          "value": 1
        },
        "Comment": {
