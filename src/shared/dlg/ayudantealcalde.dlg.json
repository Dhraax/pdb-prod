          "value": ""
        },
        "Sound": {
          "type": "resref",
          "value": ""
        },
        "Speaker": {
          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": " No, desafortunadamente no. Hay zonas restringidas que están reservadas exclusivamente para las autoridades del lugar. Sin embargo, el Salón de Gremio de Artesanos está abierto a todo aquel interesado en trabajar sus oficios y conocer más sobre las habilidades y productos de nuestros artesanos locales."
          }
        }
      },
      {
        "__struct_id": 2,
        "ActionParams": {
          "type": "list",
