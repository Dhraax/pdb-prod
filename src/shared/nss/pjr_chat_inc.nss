        case 20: sSpeaking = "Halruyano"; break;
        case 21: sSpeaking = "Ígnaro"; break;
        case 22: sSpeaking = "Iluskano"; break;
        case 23: sSpeaking = "Alzhedo"; break;
        case 24: sSpeaking = "Netherino"; break;
        case 25: sSpeaking = "Lantanés"; break;
        case 26: sSpeaking = "Midaní"; break;
        case 27: sSpeaking = "Mulano"; break;
        case 28: sSpeaking = "Nexalano"; break;
        case 30: sSpeaking = "Rashemí"; break;
        case 32: sSpeaking = "Acuano"; break;
        case 33: sSpeaking = "Serusano"; break;
        case 34: sSpeaking = "Sheirano"; break;
        case 35: sSpeaking = "Shou"; break;
        case 36: sSpeaking = "Silvano"; break;
        case 37: sSpeaking = "Argot del asesino"; break;
        case 39: sSpeaking = "Tashalano"; break;
        case 40: sSpeaking = "Primordial"; break;
        case 42: sSpeaking = "Teigano"; break;
        case 43: sSpeaking = "Túrmico"; break;
        case 44: sSpeaking = "Khessentano"; break;
        case 45: sSpeaking = "Úluik"; break;
        case 46: sSpeaking = "Infracomún"; break;
        case 47: sSpeaking = "Unzhérico"; break;
        case 49: sSpeaking = "Aurano"; break;
        case 53: sSpeaking = "Khondazhano"; break;
        case 55: sSpeaking = "Khultano"; break;
        case 56: sSpeaking = "Damarano"; break;
        case 57: sSpeaking = "Minotauro"; break;
        case 58: sSpeaking = "Gith"; break;
        //case 59: sSpeaking = "Clave inánime"; break;
        case 62: sSpeaking = "Gran trasgo"; break;
        case 63: sSpeaking = "Dambrazhano"; break;
        case 64: sSpeaking = "Duergar"; break;
        case 71: sSpeaking = "Loross"; break;
        case 72: sSpeaking = "Ogro"; break;
        case 75: sSpeaking = "Thoross"; break;
        case 78: sSpeaking = "Alto Élfico"; break;
        case 79: sSpeaking = "Druídico"; break;//"Idioma secreto"; break;
        case 80: sSpeaking = "Habla de las Profundidades"; break;
        case 81: sSpeaking = "Lenguaje de signos drow"; break;
        default: break;
        }
    return sSpeaking;
}

int GetLanguageNumber(string sTag)
{
    string sTagEnd=GetStringRight(sTag,2);
    string sTest=GetStringLeft(sTagEnd,1);

    if (sTest=="_")
    {
        sTest=GetStringRight(sTag,1);
    }
    else sTest=sTagEnd;

    return StringToInt(sTest);
}

