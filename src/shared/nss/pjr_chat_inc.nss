const string LANG_DEFAULT = "*asiente*";

string GetLanguageName(int iLanguage)
    {
    string sSpeaking=" ";
    switch(iLanguage)
        {
        case 1:  sSpeaking = "Élfico";break;
        case 2:  sSpeaking = "Gnomo"; break;
        case 3:  sSpeaking = "Mediano"; break;
        case 4:  sSpeaking = "Enano"; break;
