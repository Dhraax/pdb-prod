const string HC_TEXT_BLEED_NOW_ALIVE        = "Te has recuperado completamente.";
const string HC_TEXT_BLEED_NOW_DEAD         = "Has perdido demasiada sangre, has muerto.";

const string HC_TEXT_BLEED_NOW_RECOVERING   = "Tus heridas han parado de sangrar pero te encuentras demasiado débil como para moverte.";
const string HC_TEXT_BLEED_NOW_CONSCIOUS    = "Tus heridas han parado de sangrar. Recuperas el sentido pero te encuentras demasiado débil como para moverte.";
const string HC_TEXT_BLEED_NOW_STABLE       = "Tus heridas continuan sangrando pero más lentamente. Todavía te encuentras en peligro de morir desangrado.";

const string HC_TEXT_BLEED_STILL_BLEEDING   = "Tus heridas sangran y sigues estando inconsciente.";
const string HC_TEXT_BLEED_STILL_RECOVERING = "Sigues estando consciente pero aun te encuentras demasiado débil como para moverte. Tu salud mejora levemente.";

