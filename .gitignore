# Ignore everything
*

!.gitignore
!.gitattributes

# Whitelist devserver files
!docker-compose.yml
!docker-compose.yml
!config/
!config/**
!tools/
!tools/**
!templates/
!templates/**

# Whitelist dummy movie file
!movies/prelude.wbm

# Whitelist sources and nasher files
!nasher.cfg
!src/
!src/**
!presets/
!presets/**

# Whitelist nwn base scripts folder
!nwn-base-scripts/
!nwn-base-scripts/**

# Whitelist database files
#!database/
#!database/**

# Only keep server template file
!server/docker-compose.yml

# Whitelist batch and readme files
!*.bat
!*.sh
!*.md
!nwsync_*
!nwn_nwsync_*

# Agent instruction files are tracked: they are part of how this repository is
# maintained, and losing them loses the contract every tool works under.

# Never commit these file types
*.mod
*.ncs
*.erf
*.hak
!haks-2da/
!haks-2da/**
!tlk/
!tlk/**
!*.cmd
!sqlite3_64.dll
!nwn_tlk.exe
!nwn_erf.exe

# Blacklist individual deployment scripts that still contain local policy.
rsync.sh
nwsync.sh

# Agent tool settings are tracked too, so the permission list is reviewable.
!.claude/
!.claude/**

# Local-only: scripts y docs personales
README.md
upload_mod.bat

# Local-only: todo en tools/ raíz queda fuera (solo toolchain tools/linux y tools/win se trackea)
tools/*
!tools/linux/
!tools/win/

# Credenciales MySQL: solo se versiona el .example
config/mysql.env
!config/mysql.env.example
# Ficheros de entorno: nunca al repositorio. Solo viajan los .example.
config/nwserver.env
!config/nwserver.env.example
config/grafana.env
!config/grafana.env.example
config/influxdb.env
!config/influxdb.env.example
# Valores del host de produccion: los envia host-sync.sh, nunca git.
config/host/
cnr-editor/remote.env
cnr-editor/*.env
!cnr-editor/*.env.example
!config/mysql-init/
!config/mysql-init/**

# Herramientas de migracion del catalogo de oficios
!migration/
!migration/**

# =============================================================================
# DHRAAX FORK-ONLY RULES - TEMPORARY, KEEP THIS BLOCK AT EOF
#
# BEFORE syncing work back to git@github.com:minikanyas/pdb-dev.git, DELETE
# EVERYTHING from this separator through the end of the file. These rules are
# local to the Dhraax fork and must not be moved into the shared section above.
#
# Removing these rules does not untrack files already committed in this fork.
# An upstream-bound branch must also exclude the fork-only commit and paths
# from its diff. See documentation/repository/remote-policy.md.
# =============================================================================

# Canonical project documentation
!documentation/
!documentation/**

# CNR catalogue editor source
!cnr-editor/
!cnr-editor/**
cnr-editor/.env
cnr-editor/.env.*
!cnr-editor/.env.example
cnr-editor/**/__pycache__/
cnr-editor/**/*.py[cod]
cnr-editor/backend/.pytest_cache/
cnr-editor/backend/.ruff_cache/
cnr-editor/frontend/node_modules/
cnr-editor/frontend/dist/
cnr-editor/frontend/*.tsbuildinfo
cnr-editor/backend/.coverage
cnr-editor/backend/htmlcov/

# Repository verification and local push-safety source
!scripts/
!scripts/**
!mcp/
!mcp/**
!nwnxee
!.mcp.json
!opencode.json
!.codex/
!.codex/config.toml
!.agents/
!.agents/**
!.githooks/
!.githooks/**

# ======================== END DHRAAX FORK-ONLY BLOCK =========================

# Cache de Python del generador
migration/__pycache__/

# Reference module kept locally to migrate proven code from. Not part of this
# project and never committed: it is another module by the same author, and the
# spell effect library was imported from it. See documentation/rules/spell-effect-library.md.
/cow-scripts/

# Ultima palabra sobre los entornos del panel: la regla !cnr-editor/** de mas
# arriba los volvia a incluir.
cnr-editor/*.env
!cnr-editor/*.env.example
