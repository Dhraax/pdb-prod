        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "8": "Mira aquí al lado encontrarás la posada Minsor. Es un buen sitio para beber algo y charlar con los amigos. Tiene habitaciones para alquilar, pero la verdad no esperes encontrar mucho lujo... ¡¡Jajajaja!!"
          }
        }
      },
