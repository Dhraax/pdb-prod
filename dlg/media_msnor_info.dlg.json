        "Text": {
          "type": "cexolocstring",
          "value": {
            "8": "Saludos aventurero, bienvenido a Valle de Minsor, ¡¡jajaja!!.",
            "9": "Saludos aventurera, hacia tiempo que nadie pasaba por aquí. Es bueno ver caras nuevas, ¡¡jajaja!!"
          }
        }
      },
      {
