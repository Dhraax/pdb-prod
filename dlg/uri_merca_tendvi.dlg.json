        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "8": "Quizás en otra ocasión puedas acercarte a ver mi variedad de vinos, cervezas y licores. Actualmente la situación aquí en Caravasar es algo complicada y por orden del alcalde no podemos vender nada."
          }
        }
      },
      {
        "__struct_id": 1,
        "Animation": {
          "type": "dword",
