        "Text": {
          "type": "cexolocstring",
          "value": {
            "8": "Una enorme losa hace las veces de lápida sobre una tumba sellada por el paso de las eras."
          }
        }
      },
      {
        "__struct_id": 1,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
